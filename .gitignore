# Local environment / secrets — never commit these
.env
.env.local
.env.*.local
.env.production
*.env

# Dependencies
node_modules/

# Build output
dist/
out/
coverage/

# Master engine runtime state (ticks + learned memory); the report itself is committed
python/master/state/
__pycache__/
*.pyc

# Logs & OS junk
npm-debug.log*
yarn-error.log*
.DS_Store
