<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable id="hlstake0" type="" islocal="false" iscloud="false">stake</variable>
  </variables>

  <block type="trade_definition" id="hl_trade_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="hl_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="hl_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">higherlower</field>
            <next>
              <block type="trade_definition_contracttype" id="hl_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="hl_candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="hl_restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="hl_restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="INITIALIZATION">
      <block type="variables_set" id="hl_init_stake">
        <field name="VAR" id="hlstake0" variabletype="">stake</field>
        <value name="VALUE">
          <block type="math_number" id="hl_init_value">
            <field name="NUM">1</field>
          </block>
        </value>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="hl_tradeoptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="true" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <value name="DURATION">
          <shadow type="math_number" id="hl_duration">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="hl_amount_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="hl_amount_stake">
            <field name="VAR" id="hlstake0" variabletype="">stake</field>
          </block>
        </value>
        <value name="BARRIEROFFSET">
          <shadow type="math_number_positive" id="hl_barrier">
            <field name="NUM">0.5</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>

  <!-- Buy Higher and Lower together, once per cycle. -->
  <block type="before_purchase" id="hl_before_purchase" x="0" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase_pair" id="hl_purchase_pair">
        <field name="PURCHASE_LIST">HIGHER</field>
        <field name="PURCHASE_LIST_SECOND">LOWER</field>
      </block>
    </statement>
  </block>

  <!-- Both lost: recover at 1.4x. Anything else: back to the base stake. -->
  <block type="after_purchase" id="hl_after_purchase" x="640" y="620">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="hl_if_both_lost">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="hl_compare_result">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="pair_result" id="hl_pair_result"></block>
            </value>
            <value name="B">
              <block type="text" id="hl_loss_text">
                <field name="TEXT">loss</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="hl_martingale">
            <field name="VAR" id="hlstake0" variabletype="">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="hl_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="hl_stake_get">
                    <field name="VAR" id="hlstake0" variabletype="">stake</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="hl_factor">
                    <field name="NUM">1.4</field>
                  </shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="trade_again" id="hl_trade_again_loss"></block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="hl_reset">
            <field name="VAR" id="hlstake0" variabletype="">stake</field>
            <value name="VALUE">
              <block type="math_number" id="hl_base_stake">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="trade_again" id="hl_trade_again_win"></block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
