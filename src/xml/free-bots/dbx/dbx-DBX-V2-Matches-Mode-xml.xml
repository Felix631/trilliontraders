      <block type="controls_if" id="if_dbx_e2">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="cmp_dbx_e3">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="total_profit" id="tp_dbx_e4"></block>
