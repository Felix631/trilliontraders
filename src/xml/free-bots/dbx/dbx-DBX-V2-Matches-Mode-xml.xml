            <value name="B">
              <block type="variables_get" id="get_dbx_e5">
                <field name="VAR" id="var_TakeProfit_dbxc3">TakeProfit</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="ntf_dbx_e6">
            <field name="NOTIFICATION_TYPE">success</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="txt_dbx_e7">
                <field name="TEXT">Take profit reached - DBX V2 stopped</field>
              </shadow>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="if_dbx_e8">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="ck_dbx_e9">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="set_dbx_ea">
                <field name="VAR" id="var_Stake_dbxa1">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_dbx_eb">
                    <field name="VAR" id="var_InitialStake_dbxb2">InitialStake</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_dbx_ec">
                    <field name="VAR" id="var_lossCounter_dbxf6">lossCounter</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_dbx_ed">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="set_dbx_ee">
                <field name="VAR" id="var_Stake_dbxa1">Stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="arith_dbx_ef">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <shadow type="math_number" id="num_dbx_eg">
                        <field name="NUM">1</field>
                      </shadow>
                      <block type="variables_get" id="get_dbx_eh">
                        <field name="VAR" id="var_Stake_dbxa1">Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="num_dbx_ei">
                        <field name="NUM">1</field>
                      </shadow>
                      <block type="variables_get" id="get_dbx_ej">
                        <field name="VAR" id="var_Martingale_dbxd4">Martingale</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="math_change" id="chg_dbx_ek">
                    <field name="VAR" id="var_lossCounter_dbxf6">lossCounter</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="num_dbx_el">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="if_dbx_em">
                <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="cmp_dbx_en">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="get_dbx_eo">
                        <field name="VAR" id="var_lossCounter_dbxf6">lossCounter</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_dbx_ep">
                        <field name="VAR" id="var_MartingaleLevel_dbxe5">MartingaleLevel</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_again" id="ta_dbx_eq"></block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="ntf_dbx_er">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="txt_dbx_es">
                        <field name="TEXT">Max recovery reached - DBX V2 stopped</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
