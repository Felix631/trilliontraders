                <value name="VALUE">
                  <block type="math_number" id="num_dbx_b6">
                    <field name="NUM">15</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_dbx_b7">
                    <field name="VAR" id="var_Martingale_dbxd4">Martingale</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_dbx_b8">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_dbx_b9">
