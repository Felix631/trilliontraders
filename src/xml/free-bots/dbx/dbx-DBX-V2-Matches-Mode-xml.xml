                        <value name="VALUE">
                          <block type="math_number" id="num_dbx_ba">
                            <field name="NUM">5</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_dbx_bb">
                            <field name="VAR" id="var_lossCounter_dbxf6">lossCounter</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_dbx_bc">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_dbx_bd">
                                <field name="VAR" id="var_Prediction_dbxg7">Prediction</field>
                                <value name="VALUE">
                                  <block type="math_number" id="num_dbx_be">
                                    <field name="NUM">4</field>
                                  </block>
                                </value>
                              </block>
