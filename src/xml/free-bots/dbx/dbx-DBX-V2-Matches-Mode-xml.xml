    <variable id="var_InitialStake_dbxb2">InitialStake</variable>
    <variable id="var_TakeProfit_dbxc3">TakeProfit</variable>
    <variable id="var_Martingale_dbxd4">Martingale</variable>
    <variable id="var_MartingaleLevel_dbxe5">MartingaleLevel</variable>
    <variable id="var_lossCounter_dbxf6">lossCounter</variable>
    <variable id="var_Prediction_dbxg7">Prediction</variable>
  </variables>
  <block type="trade_definition" id="td_dbx_a1" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="mkt_dbx_a2" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="tt_dbx_a3" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="ct_dbx_a4" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="ci_dbx_a5" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="rs_dbx_a6" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="re_dbx_a7" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_dbx_b1">
        <field name="VAR" id="var_Stake_dbxa1">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_dbx_b2">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_dbx_b3">
