        <field name="VAR" id="var_Prediction_dbxg7">Prediction</field>
        <value name="VALUE">
          <block type="math_on_list" id="mol_dbx_d3">
            <mutation op="MODE"></mutation>
            <field name="OP">MODE</field>
            <value name="LIST">
              <block type="stat_list" id="sl_dbx_d4"></block>
            </value>
          </block>
        </value>
        <next>
          <block type="purchase" id="pur_dbx_d5">
            <field name="PURCHASE_LIST">DIGITMATCH</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
