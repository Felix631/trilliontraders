<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="var_Stake_dbxr1">Stake</variable>
    <variable id="var_InitialStake_dbxr2">InitialStake</variable>
    <variable id="var_TakeProfit_dbxr3">TakeProfit</variable>
    <variable id="var_Martingale_dbxr4">Martingale</variable>
    <variable id="var_MartingaleLevel_dbxr5">MartingaleLevel</variable>
    <variable id="var_lossCounter_dbxr6">lossCounter</variable>
    <variable id="var_Prediction_dbxr7">Prediction</variable>
  </variables>
  <block type="trade_definition" id="td_dbxr_a1" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="mkt_dbxr_a2" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="tt_dbxr_a3" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="ct_dbxr_a4" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="ci_dbxr_a5" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="rs_dbxr_a6" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="re_dbxr_a7" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_dbxr_b1">
        <field name="VAR" id="var_Stake_dbxr1">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_dbxr_b2">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_dbxr_b3">
            <field name="VAR" id="var_InitialStake_dbxr2">InitialStake</field>
            <value name="VALUE">
              <block type="math_number" id="num_dbxr_b4">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_dbxr_b5">
                <field name="VAR" id="var_TakeProfit_dbxr3">TakeProfit</field>
                <value name="VALUE">
                  <block type="math_number" id="num_dbxr_b6">
                    <field name="NUM">15</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_dbxr_b7">
                    <field name="VAR" id="var_Martingale_dbxr4">Martingale</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_dbxr_b8">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_dbxr_b9">
                        <field name="VAR" id="var_MartingaleLevel_dbxr5">MartingaleLevel</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_dbxr_ba">
                            <field name="NUM">5</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_dbxr_bb">
                            <field name="VAR" id="var_lossCounter_dbxr6">lossCounter</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_dbxr_bc">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_dbxr_bd">
                                <field name="VAR" id="var_Prediction_dbxr7">Prediction</field>
                                <value name="VALUE">
                                  <block type="math_number" id="num_dbxr_be">
                                    <field name="NUM">4</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="to_dbxr_c1">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="dur_dbxr_c2">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="amt_dbxr_c3">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="get_dbxr_c4">
            <field name="VAR" id="var_Stake_dbxr1">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="pred_dbxr_c5">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="get_dbxr_c6">
            <field name="VAR" id="var_Prediction_dbxr7">Prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="bp_dbxr_d1" deletable="false" x="0" y="640">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="set_dbxr_d2">
        <field name="VAR" id="var_Prediction_dbxr7">Prediction</field>
        <value name="VALUE">
          <block type="math_on_list" id="mol_dbxr_d3">
            <mutation op="RANDOM"></mutation>
            <field name="OP">RANDOM</field>
            <value name="LIST">
              <block type="stat_list" id="sl_dbxr_d4"></block>
            </value>
          </block>
        </value>
        <next>
          <block type="purchase" id="pur_dbxr_d5">
            <field name="PURCHASE_LIST">DIGITMATCH</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="ap_dbxr_e1" x="714" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="if_dbxr_e2">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="cmp_dbxr_e3">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="total_profit" id="tp_dbxr_e4"></block>
            </value>
            <value name="B">
              <block type="variables_get" id="get_dbxr_e5">
                <field name="VAR" id="var_TakeProfit_dbxr3">TakeProfit</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="ntf_dbxr_e6">
            <field name="NOTIFICATION_TYPE">success</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="txt_dbxr_e7">
                <field name="TEXT">Take profit reached - DBX V2 Random stopped</field>
              </shadow>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="if_dbxr_e8">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="ck_dbxr_e9">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="set_dbxr_ea">
                <field name="VAR" id="var_Stake_dbxr1">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_dbxr_eb">
                    <field name="VAR" id="var_InitialStake_dbxr2">InitialStake</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_dbxr_ec">
                    <field name="VAR" id="var_lossCounter_dbxr6">lossCounter</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_dbxr_ed">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="set_dbxr_ee">
                <field name="VAR" id="var_Stake_dbxr1">Stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="arith_dbxr_ef">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <shadow type="math_number" id="num_dbxr_eg">
                        <field name="NUM">1</field>
                      </shadow>
                      <block type="variables_get" id="get_dbxr_eh">
                        <field name="VAR" id="var_Stake_dbxr1">Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="num_dbxr_ei">
                        <field name="NUM">1</field>
                      </shadow>
                      <block type="variables_get" id="get_dbxr_ej">
                        <field name="VAR" id="var_Martingale_dbxr4">Martingale</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="math_change" id="chg_dbxr_ek">
                    <field name="VAR" id="var_lossCounter_dbxr6">lossCounter</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="num_dbxr_el">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="if_dbxr_em">
                <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="cmp_dbxr_en">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="get_dbxr_eo">
                        <field name="VAR" id="var_lossCounter_dbxr6">lossCounter</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_dbxr_ep">
                        <field name="VAR" id="var_MartingaleLevel_dbxr5">MartingaleLevel</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_again" id="ta_dbxr_eq"></block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="ntf_dbxr_er">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="txt_dbxr_es">
                        <field name="TEXT">Max recovery reached - DBX V2 Random stopped</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
