<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="sdse_stake">Stake</variable>
    <variable id="sdse_initialStake">initialStake</variable>
    <variable id="sdse_lossCount">lossCount</variable>
    <variable id="sdse_martingale">Martingale</variable>
  </variables>
  <block type="trade_definition" id="sdse_trade_def" deletable="false" x="0" y="60">
    <field name="PARAM_LABEL">NONE</field>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="sdse_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="sdse_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="sdse_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITEVEN</field>
                <next>
                  <block type="trade_definition_candleinterval" id="sdse_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="sdse_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="sdse_restarterror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="sdse_set_stake">
        <field name="VAR" id="sdse_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="sdse_stake_val">
            <field name="NUM">2</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="sdse_set_initial">
            <field name="VAR" id="sdse_initialStake">initialStake</field>
            <value name="VALUE">
              <block type="math_number" id="sdse_initial_val">
                <field name="NUM">2</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="sdse_set_martingale">
                <field name="VAR" id="sdse_martingale">Martingale</field>
                <value name="VALUE">
                  <block type="math_number" id="sdse_martingale_val">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="sdse_set_loss">
                    <field name="VAR" id="sdse_lossCount">lossCount</field>
                    <value name="VALUE">
                      <block type="math_number" id="sdse_loss_val">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="sdse_tradeoptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="sdse_dur_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="math_number" id="sdse_dur_val">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="sdse_amt_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="sdse_amt_var">
            <field name="VAR" id="sdse_stake">Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="sdse_before_purchase" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="sdse_recovery_route">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="sdse_loss_gte">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="variables_get" id="sdse_loss_get">
                <field name="VAR" id="sdse_lossCount">lossCount</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="sdse_loss_threshold">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="strategy_special_under_4_apply" id="sdse_special_u4"></block>
        </statement>
        <statement name="ELSE">
          <block type="strategy_even_odd_all_markets_apply" id="sdse_even_odd_all"></block>
        </statement>
        <next>
          <block type="purchase" id="sdse_purchase">
            <field name="PURCHASE_LIST">DIGITEVEN</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="sdse_after_purchase" x="722" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="sdse_win_check">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="sdse_check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="sdse_win_reset_loss">
            <field name="VAR" id="sdse_lossCount">lossCount</field>
            <value name="VALUE">
              <block type="math_number" id="sdse_win_loss_val">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="sdse_win_reset_stake">
                <field name="VAR" id="sdse_stake">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="sdse_win_initial_get">
                    <field name="VAR" id="sdse_initialStake">initialStake</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="sdse_loss_double_stake">
            <field name="VAR" id="sdse_stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="sdse_loss_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <shadow type="math_number" id="sdse_mult_a_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="sdse_mult_stake_get">
                    <field name="VAR" id="sdse_stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="sdse_mult_b_shadow">
                    <field name="NUM">2</field>
                  </shadow>
                  <block type="variables_get" id="sdse_mult_martingale_get">
                    <field name="VAR" id="sdse_martingale">Martingale</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="math_change" id="sdse_loss_increment">
                <field name="VAR" id="sdse_lossCount">lossCount</field>
                <value name="DELTA">
                  <shadow type="math_number" id="sdse_loss_delta">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="sdse_trade_again"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
