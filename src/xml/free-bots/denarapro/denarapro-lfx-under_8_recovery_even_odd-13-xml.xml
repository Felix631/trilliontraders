<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="u8_stake">Stake</variable>
    <variable id="u8_initialStake">initialStake</variable>
    <variable id="u8_lossCount">lossCount</variable>
    <variable id="u8_martingale">Martingale</variable>
  </variables>
  <block type="trade_definition" id="u8_trade_def" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="u8_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="u8_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="u8_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITUNDER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="u8_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="u8_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="u8_restarterror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="u8_set_stake">
        <field name="VAR" id="u8_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="u8_stake_val">
            <field name="NUM">2</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="u8_set_initial">
            <field name="VAR" id="u8_initialStake">initialStake</field>
            <value name="VALUE">
              <block type="math_number" id="u8_initial_val">
                <field name="NUM">2</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="u8_set_martingale">
                <field name="VAR" id="u8_martingale">Martingale</field>
                <value name="VALUE">
                  <block type="math_number" id="u8_martingale_val">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="u8_set_loss">
                    <field name="VAR" id="u8_lossCount">lossCount</field>
                    <value name="VALUE">
                      <block type="math_number" id="u8_loss_val">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="u8_tradeoptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="u8_dur_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="math_number" id="u8_dur_val">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="u8_amt_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="u8_amt_var">
            <field name="VAR" id="u8_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="u8_pred_shadow">
            <field name="NUM">8</field>
          </shadow>
          <block type="math_number" id="u8_pred_val">
            <field name="NUM">8</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="u8_before_purchase" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="u8_purchase">
        <field name="PURCHASE_LIST">DIGITUNDER</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="u8_after_purchase" x="722" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="u8_win_check">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="u8_check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="u8_win_reset_loss">
            <field name="VAR" id="u8_lossCount">lossCount</field>
            <value name="VALUE">
              <block type="math_number" id="u8_win_loss_val">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="u8_win_reset_stake">
                <field name="VAR" id="u8_stake">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="u8_win_initial_get">
                    <field name="VAR" id="u8_initialStake">initialStake</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="u8_loss_double_stake">
            <field name="VAR" id="u8_stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="u8_loss_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <shadow type="math_number" id="u8_mult_a_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="u8_mult_stake_get">
                    <field name="VAR" id="u8_stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="u8_mult_b_shadow">
                    <field name="NUM">2</field>
                  </shadow>
                  <block type="variables_get" id="u8_mult_martingale_get">
                    <field name="VAR" id="u8_martingale">Martingale</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="math_change" id="u8_loss_increment">
                <field name="VAR" id="u8_lossCount">lossCount</field>
                <value name="DELTA">
                  <shadow type="math_number" id="u8_loss_delta">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="u8_trade_again"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
