<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="rs_stake">Stake</variable>
    <variable id="rs_initialStake">initialStake</variable>
    <variable id="rs_prediction">prediction</variable>
    <variable id="rs_lossCount">lossCount</variable>
    <variable id="rs_predBefore">Prediction before loss</variable>
    <variable id="rs_predAfter">prediction after loss</variable>
    <variable id="rs_profit">lastProfit</variable>
  </variables>
  <block type="trade_definition" id="rs_trade_def" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="rs_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="rs_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="rs_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITOVER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="rs_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="rs_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="rs_restarterror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="rs_set_stake">
        <field name="VAR" id="rs_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="rs_stake_val">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="rs_set_initial">
            <field name="VAR" id="rs_initialStake">initialStake</field>
            <value name="VALUE">
              <block type="math_number" id="rs_initial_val">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="rs_set_pred_before">
                <field name="VAR" id="rs_predBefore">Prediction before loss</field>
                <value name="VALUE">
                  <block type="math_number" id="rs_pred_before_val">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="rs_set_pred_after">
                    <field name="VAR" id="rs_predAfter">prediction after loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="rs_pred_after_val">
                        <field name="NUM">3</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="rs_set_loss">
                        <field name="VAR" id="rs_lossCount">lossCount</field>
                        <value name="VALUE">
                          <block type="math_number" id="rs_loss_val">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="rs_set_profit">
                            <field name="VAR" id="rs_profit">lastProfit</field>
                            <value name="VALUE">
                              <block type="math_number" id="rs_profit_val">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="controls_if" id="rs_pred_if">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="rs_pred_cmp">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="rs_pred_loss_get">
                <field name="VAR" id="rs_lossCount">lossCount</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="rs_pred_zero">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="rs_set_pred_normal">
            <field name="VAR" id="rs_prediction">prediction</field>
            <value name="VALUE">
              <block type="variables_get" id="rs_get_pred_before">
                <field name="VAR" id="rs_predBefore">Prediction before loss</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="rs_pred_else_if">
            <value name="IF0">
              <block type="logic_compare" id="rs_pred_else_cmp">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="rs_pred_else_loss">
                    <field name="VAR" id="rs_lossCount">lossCount</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="rs_pred_else_one">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="rs_set_pred_after_loss">
                <field name="VAR" id="rs_prediction">prediction</field>
                <value name="VALUE">
                  <block type="variables_get" id="rs_get_pred_after">
                    <field name="VAR" id="rs_predAfter">prediction after loss</field>
                  </block>
                </value>
              </block>
            </statement>
          </block>
        </statement>
        <next>
          <block type="trade_definition_tradeoptions" id="rs_tradeoptions">
            <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
            <field name="DURATIONTYPE_LIST">t</field>
            <value name="DURATION">
              <shadow type="math_number" id="rs_dur_shadow">
                <field name="NUM">1</field>
              </shadow>
              <block type="math_number" id="rs_dur_val">
                <field name="NUM">1</field>
              </block>
            </value>
            <value name="AMOUNT">
              <shadow type="math_number" id="rs_amt_shadow">
                <field name="NUM">1</field>
              </shadow>
              <block type="variables_get" id="rs_amt_var">
                <field name="VAR" id="rs_stake">Stake</field>
              </block>
            </value>
            <value name="PREDICTION">
              <shadow type="math_number_positive" id="rs_pred_shadow">
                <field name="NUM">1</field>
              </shadow>
              <block type="variables_get" id="rs_pred_var">
                <field name="VAR" id="rs_prediction">prediction</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="rs_after_purchase" x="722" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="rs_win_check">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="rs_check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <!-- WIN: reset lossCount, read profit, scale stake = stake + profit -->
          <block type="variables_set" id="rs_win_reset_loss">
            <field name="VAR" id="rs_lossCount">lossCount</field>
            <value name="VALUE">
              <block type="math_number" id="rs_win_loss_zero">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="rs_win_store_profit">
                <field name="VAR" id="rs_profit">lastProfit</field>
                <value name="VALUE">
                  <block type="read_details" id="rs_read_profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="rs_win_scale_stake">
                    <field name="VAR" id="rs_stake">Stake</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="rs_add_profit">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <shadow type="math_number" id="rs_add_a_shadow">
                            <field name="NUM">1</field>
                          </shadow>
                          <block type="variables_get" id="rs_add_stake">
                            <field name="VAR" id="rs_stake">Stake</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="rs_add_b_shadow">
                            <field name="NUM">0</field>
                          </shadow>
                          <block type="variables_get" id="rs_add_profit_var">
                            <field name="VAR" id="rs_profit">lastProfit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <!-- LOSS: reset stake to initial, increment lossCount -->
          <block type="variables_set" id="rs_loss_reset_stake">
            <field name="VAR" id="rs_stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="rs_loss_initial">
                <field name="VAR" id="rs_initialStake">initialStake</field>
              </block>
            </value>
            <next>
              <block type="math_change" id="rs_loss_increment">
                <field name="VAR" id="rs_lossCount">lossCount</field>
                <value name="DELTA">
                  <shadow type="math_number" id="rs_loss_delta">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="rs_trade_again"></block>
        </next>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="rs_before_purchase" deletable="false" x="0" y="1248">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="rs_bp_if">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="rs_bp_cmp">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="rs_bp_loss_get">
                <field name="VAR" id="rs_lossCount">lossCount</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="rs_bp_zero">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="rs_purchase_normal">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="rs_bp_else_if">
            <value name="IF0">
              <block type="logic_compare" id="rs_bp_else_cmp">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="variables_get" id="rs_bp_else_loss">
                    <field name="VAR" id="rs_lossCount">lossCount</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="rs_bp_else_one">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="purchase" id="rs_purchase_loss">
                <field name="PURCHASE_LIST">DIGITOVER</field>
              </block>
            </statement>
            <next>
              <block type="purchase" id="rs_purchase_loss2">
                <field name="PURCHASE_LIST">DIGITOVER</field>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
