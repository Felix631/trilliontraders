<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="stake_id">stake</variable>
    <variable id="initial_stake_id">initial_stake</variable>
    <variable id="martingale_factor_id">martingale_factor</variable>
    <variable id="take_profit_id">take_profit</variable>
    <variable id="stop_loss_id">stop_loss</variable>
    <variable id="duration_id">duration</variable>
    <variable id="consecutive_losses_id">consecutive_losses</variable>
  </variables>

  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_cfg">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_cfg">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">risefall</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_cfg">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_cfg">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_buysell">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restart_on_error">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_stake_1">
        <field name="VAR" id="stake_id">stake</field>
        <value name="VALUE">
          <block type="math_number" id="stake_val_1"><field name="NUM">0.5</field></block>
        </value>
        <next>
          <block type="variables_set" id="set_initial_stake">
            <field name="VAR" id="initial_stake_id">initial_stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_stake_for_init">
                <field name="VAR" id="stake_id">stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_martingale">
                <field name="VAR" id="martingale_factor_id">martingale_factor</field>
                <value name="VALUE">
                  <block type="math_number" id="martingale_val"><field name="NUM">2</field></block>
                </value>
                <next>
                  <block type="variables_set" id="set_take_profit">
                    <field name="VAR" id="take_profit_id">take_profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="tp_val"><field name="NUM">20</field></block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_stop_loss">
                        <field name="VAR" id="stop_loss_id">stop_loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="sl_val"><field name="NUM">150</field></block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_duration">
                            <field name="VAR" id="duration_id">duration</field>
                            <value name="VALUE">
                              <block type="math_number" id="dur_val"><field name="NUM">5</field></block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_consec_losses">
                                <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                                <value name="VALUE">
                                  <block type="math_number" id="consec_val"><field name="NUM">0</field></block>
                                </value>
                                <next>
                                  <block type="notify" id="init_notify">
                                    <field name="NOTIFICATION_TYPE">info</field>
                                    <field name="NOTIFICATION_SOUND">silent</field>
                                    <value name="MESSAGE">
                                      <shadow type="text" id="init_notify_shadow"><field name="TEXT">Bot initialization info</field></shadow>
                                      <block type="text_join" id="init_join">
                                        <mutation items="8"></mutation>
                                        <value name="ADD0"><block type="text" id="init_t0"><field name="TEXT">Bot initialized | Market: 1HZ50V | Stake: $</field></block></value>
                                        <value name="ADD1"><block type="variables_get" id="init_g_stake"><field name="VAR" id="stake_id">stake</field></block></value>
                                        <value name="ADD2"><block type="text" id="init_t2"><field name="TEXT"> | TP: $</field></block></value>
                                        <value name="ADD3"><block type="variables_get" id="init_g_tp"><field name="VAR" id="take_profit_id">take_profit</field></block></value>
                                        <value name="ADD4"><block type="text" id="init_t4"><field name="TEXT"> | SL: $</field></block></value>
                                        <value name="ADD5"><block type="variables_get" id="init_g_sl"><field name="VAR" id="stop_loss_id">stop_loss</field></block></value>
                                        <value name="ADD6"><block type="text" id="init_t6"><field name="TEXT"> | Duration: </field></block></value>
                                        <value name="ADD7"><block type="variables_get" id="init_g_dur"><field name="VAR" id="duration_id">duration</field></block></value>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_cfg">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="dur_shadow"><field name="NUM">5</field></shadow>
          <block type="variables_get" id="get_duration_val">
            <field name="VAR" id="duration_id">duration</field>
          </block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amt_shadow"><field name="NUM">0.5</field></shadow>
          <block type="variables_get" id="get_stake_val">
            <field name="VAR" id="stake_id">stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_main" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify" id="scan_notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE">
          <shadow type="text" id="scan_shadow"><field name="TEXT">Scanning market direction</field></shadow>
          <block type="text_join" id="scan_join">
            <mutation items="2"></mutation>
            <value name="ADD0"><block type="text" id="scan_t0"><field name="TEXT">Scanning market direction | Stake: $</field></block></value>
            <value name="ADD1"><block type="variables_get" id="scan_g_stake"><field name="VAR" id="stake_id">stake</field></block></value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="direction_check">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="check_direction" id="dir_rise">
                <field name="CHECK_DIRECTION">rise</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="call_notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="call_shadow"><field name="TEXT">Placing Rise trade</field></shadow>
                  <block type="text_join" id="call_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0"><block type="text" id="call_t0"><field name="TEXT">Market rising | Placing CALL (Rise) | Stake: $</field></block></value>
                    <value name="ADD1"><block type="variables_get" id="call_g_stake"><field name="VAR" id="stake_id">stake</field></block></value>
                  </block>
                </value>
                <next>
                  <block type="purchase" id="buy_call">
                    <field name="PURCHASE_LIST">CALL</field>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify" id="put_notify">
                <field name="NOTIFICATION_TYPE">warn</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="put_shadow"><field name="TEXT">Placing Fall trade</field></shadow>
                  <block type="text_join" id="put_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0"><block type="text" id="put_t0"><field name="TEXT">Market falling | Placing PUT (Fall) | Stake: $</field></block></value>
                    <value name="ADD1"><block type="variables_get" id="put_g_stake"><field name="VAR" id="stake_id">stake</field></block></value>
                  </block>
                </value>
                <next>
                  <block type="purchase" id="buy_put">
                    <field name="PURCHASE_LIST">PUT</field>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_main" x="600" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="win_loss_check">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake_win">
            <field name="VAR" id="stake_id">stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_initial_stake_win">
                <field name="VAR" id="initial_stake_id">initial_stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_losses_win">
                <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                <value name="VALUE">
                  <block type="math_number" id="reset_losses_val"><field name="NUM">0</field></block>
                </value>
                <next>
                  <block type="notify" id="win_notify">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">earned-money</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="win_shadow"><field name="TEXT">Trade win result</field></shadow>
                      <block type="text_join" id="win_join">
                        <mutation items="6"></mutation>
                        <value name="ADD0"><block type="text" id="win_t0"><field name="TEXT">â WIN | Profit: $</field></block></value>
                        <value name="ADD1"><block type="read_details" id="win_profit"><field name="DETAIL_INDEX">4</field></block></value>
                        <value name="ADD2"><block type="text" id="win_t2"><field name="TEXT"> | Total: $</field></block></value>
                        <value name="ADD3"><block type="total_profit" id="win_total"></block></value>
                        <value name="ADD4"><block type="text" id="win_t4"><field name="TEXT"> | Stake reset to $</field></block></value>
                        <value name="ADD5"><block type="variables_get" id="win_g_stake"><field name="VAR" id="stake_id">stake</field></block></value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="martingale_stake">
            <field name="VAR" id="stake_id">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="stake_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="get_stake_loss">
                    <field name="VAR" id="stake_id">stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_martingale_loss">
                    <field name="VAR" id="martingale_factor_id">martingale_factor</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="inc_losses">
                <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="losses_plus_1">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="variables_get" id="get_losses_inc">
                        <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="one_val"><field name="NUM">1</field></block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="notify" id="loss_notify">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">error</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="loss_shadow"><field name="TEXT">Trade loss result</field></shadow>
                      <block type="text_join" id="loss_join">
                        <mutation items="8"></mutation>
                        <value name="ADD0"><block type="text" id="loss_t0"><field name="TEXT">â LOSS | Loss: $</field></block></value>
                        <value name="ADD1"><block type="read_details" id="loss_profit"><field name="DETAIL_INDEX">4</field></block></value>
                        <value name="ADD2"><block type="text" id="loss_t2"><field name="TEXT"> | Total: $</field></block></value>
                        <value name="ADD3"><block type="total_profit" id="loss_total"></block></value>
                        <value name="ADD4"><block type="text" id="loss_t4"><field name="TEXT"> | New stake: $</field></block></value>
                        <value name="ADD5"><block type="variables_get" id="loss_g_stake"><field name="VAR" id="stake_id">stake</field></block></value>
                        <value name="ADD6"><block type="text" id="loss_t6"><field name="TEXT"> | Consecutive losses: </field></block></value>
                        <value name="ADD7"><block type="variables_get" id="loss_g_consec"><field name="VAR" id="consecutive_losses_id">consecutive_losses</field></block></value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
      <next>
        <block type="notify" id="limit_check_notify">
          <field name="NOTIFICATION_TYPE">info</field>
          <field name="NOTIFICATION_SOUND">silent</field>
          <value name="MESSAGE">
            <shadow type="text" id="limit_shadow"><field name="TEXT">Checking profit limits</field></shadow>
            <block type="text_join" id="limit_join">
              <mutation items="2"></mutation>
              <value name="ADD0"><block type="text" id="limit_t0"><field name="TEXT">Checking limits | Total profit: $</field></block></value>
              <value name="ADD1"><block type="total_profit" id="limit_total"></block></value>
            </block>
          </value>
          <next>
            <block type="controls_if" id="tp_sl_check">
              <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
              <value name="IF0">
                <block type="logic_compare" id="tp_cmp">
                  <field name="OP">GTE</field>
                  <value name="A">
                    <block type="total_profit" id="tp_total"></block>
                  </value>
                  <value name="B">
                    <block type="variables_get" id="get_tp">
                      <field name="VAR" id="take_profit_id">take_profit</field>
                    </block>
                  </value>
                </block>
              </value>
              <statement name="DO0">
                <block type="notify" id="tp_notify">
                  <field name="NOTIFICATION_TYPE">success</field>
                  <field name="NOTIFICATION_SOUND">job-done</field>
                  <value name="MESSAGE">
                    <shadow type="text" id="tp_shadow"><field name="TEXT">Take profit reached</field></shadow>
                    <block type="text_join" id="tp_join">
                      <mutation items="2"></mutation>
                      <value name="ADD0"><block type="text" id="tp_t0"><field name="TEXT">ð¯ TAKE PROFIT REACHED | Total: $</field></block></value>
                      <value name="ADD1"><block type="total_profit" id="tp_final"></block></value>
                    </block>
                  </value>
                  <next>
                    <block type="trade_stop" id="do_tp"></block>
                  </next>
                </block>
              </statement>
              <value name="IF1">
                <block type="logic_compare" id="sl_cmp">
                  <field name="OP">LTE</field>
                  <value name="A">
                    <block type="total_profit" id="sl_total"></block>
                  </value>
                  <value name="B">
                    <block type="math_single" id="negate_sl">
                      <field name="OP">NEG</field>
                      <value name="NUM">
                        <shadow type="math_number" id="sl_num_shadow"><field name="NUM">150</field></shadow>
                        <block type="variables_get" id="get_sl">
                          <field name="VAR" id="stop_loss_id">stop_loss</field>
                        </block>
                      </value>
                    </block>
                  </value>
                </block>
              </value>
              <statement name="DO1">
                <block type="notify" id="sl_notify">
                  <field name="NOTIFICATION_TYPE">error</field>
                  <field name="NOTIFICATION_SOUND">error</field>
                  <value name="MESSAGE">
                    <shadow type="text" id="sl_shadow"><field name="TEXT">Stop loss reached</field></shadow>
                    <block type="text_join" id="sl_join">
                      <mutation items="2"></mutation>
                      <value name="ADD0"><block type="text" id="sl_t0"><field name="TEXT">ð STOP LOSS REACHED | Total: $</field></block></value>
                      <value name="ADD1"><block type="total_profit" id="sl_final"></block></value>
                    </block>
                  </value>
                  <next>
                    <block type="trade_stop" id="do_sl"></block>
                  </next>
                </block>
              </statement>
              <statement name="ELSE">
                <block type="notify" id="continue_notify">
                  <field name="NOTIFICATION_TYPE">info</field>
                  <field name="NOTIFICATION_SOUND">silent</field>
                  <value name="MESSAGE">
                    <shadow type="text" id="continue_shadow"><field name="TEXT">Continuing trading</field></shadow>
                    <block type="text_join" id="continue_join">
                      <mutation items="2"></mutation>
                      <value name="ADD0"><block type="text" id="cont_t0"><field name="TEXT">Continuing... | Total profit: $</field></block></value>
                      <value name="ADD1"><block type="total_profit" id="cont_total"></block></value>
                    </block>
                  </value>
                  <next>
                    <block type="trade_again" id="do_trade_again"></block>
                  </next>
                </block>
              </statement>
            </block>
          </next>
        </block>
      </next>
    </statement>
  </block>
</xml>
