<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="var_stake">stake</variable>
    <variable id="var_over_prediction">over_prediction</variable>
    <variable id="var_recovery_mode">recovery_mode</variable>
    <variable id="var_under_prediction">under_prediction</variable>
    <variable id="var_next_trade">next_trade</variable>
    <variable id="var_take_profit">take_profit</variable>
    <variable id="var_stake_backup">stake_backup</variable>
    <variable id="var_martingale">martingale</variable>
    <variable id="var_stop_loss">stop_loss</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="trade_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_buysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_stake">
        <field name="VAR" id="var_stake">stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_stake">
            <field name="NUM">0.35</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_over_pred">
            <field name="VAR" id="var_over_prediction">over_prediction</field>
            <value name="VALUE">
              <block type="math_number" id="num_over_pred">
                <field name="NUM">5</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_under_pred">
                <field name="VAR" id="var_under_prediction">under_prediction</field>
                <value name="VALUE">
                  <block type="math_number" id="num_under_pred">
                    <field name="NUM">4</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_take_profit">
                    <field name="VAR" id="var_take_profit">take_profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_take_profit">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_stop_loss">
                        <field name="VAR" id="var_stop_loss">stop_loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_stop_loss">
                            <field name="NUM">600</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_martingale">
                            <field name="VAR" id="var_martingale">martingale</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_martingale">
                                <field name="NUM">1.7</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_recovery_mode">
                                <field name="VAR" id="var_recovery_mode">recovery_mode</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="bool_recovery_false">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="set_next_trade">
                                    <field name="VAR" id="var_next_trade">next_trade</field>
                                    <value name="VALUE">
                                      <block type="text" id="text_under">
                                        <field name="TEXT">UNDER</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="set_stake_backup">
                                        <field name="VAR" id="var_stake_backup">stake_backup</field>
                                        <value name="VALUE">
                                          <block type="variables_get" id="get_stake_init">
                                            <field name="VAR" id="var_stake">stake</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="controls_if" id="if_next_trade">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="compare_under">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_next_trade">
                <field name="VAR" id="var_next_trade">next_trade</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="text_under_cmp">
                <field name="TEXT">UNDER</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="trade_definition_tradeoptions" id="trade_opts_under">
            <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
            <field name="DURATIONTYPE_LIST">t</field>
            <value name="DURATION">
              <shadow type="math_number_positive" id="dur_shadow_1">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <value name="AMOUNT">
              <shadow type="math_number_positive" id="amt_shadow_1">
                <field name="NUM">0.35</field>
              </shadow>
              <block type="variables_get" id="get_stake_under">
                <field name="VAR" id="var_stake">stake</field>
              </block>
            </value>
            <value name="PREDICTION">
              <shadow type="math_number_positive" id="pred_shadow_1">
                <field name="NUM">1</field>
              </shadow>
              <block type="variables_get" id="get_over_pred">
                <field name="VAR" id="var_over_prediction">over_prediction</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="trade_definition_tradeoptions" id="trade_opts_over">
            <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
            <field name="DURATIONTYPE_LIST">t</field>
            <value name="DURATION">
              <shadow type="math_number_positive" id="dur_shadow_2">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <value name="AMOUNT">
              <shadow type="math_number_positive" id="amt_shadow_2">
                <field name="NUM">0.35</field>
              </shadow>
              <block type="variables_get" id="get_stake_over">
                <field name="VAR" id="var_stake">stake</field>
              </block>
            </value>
            <value name="PREDICTION">
              <shadow type="math_number_positive" id="pred_shadow_2">
                <field name="NUM">1</field>
              </shadow>
              <block type="variables_get" id="get_under_pred">
                <field name="VAR" id="var_under_prediction">under_prediction</field>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_purchase_block" x="746" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="if_win_loss">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="set_recovery_false">
            <field name="VAR" id="var_recovery_mode">recovery_mode</field>
            <value name="VALUE">
              <block type="logic_boolean" id="bool_false_win">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_stake">
                <field name="VAR" id="var_stake">stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_stake_backup">
                    <field name="VAR" id="var_stake_backup">stake_backup</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="switch_trade_type">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="compare_not_under">
                        <field name="OP">NEQ</field>
                        <value name="A">
                          <block type="variables_get" id="get_next_trade_switch">
                            <field name="VAR" id="var_next_trade">next_trade</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="text" id="text_under_switch">
                            <field name="TEXT">UNDER</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="set_next_under">
                        <field name="VAR" id="var_next_trade">next_trade</field>
                        <value name="VALUE">
                          <block type="text" id="text_set_under">
                            <field name="TEXT">UNDER</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="variables_set" id="set_next_over">
                        <field name="VAR" id="var_next_trade">next_trade</field>
                        <value name="VALUE">
                          <block type="text" id="text_set_over">
                            <field name="TEXT">OVER</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="increase_stake">
            <field name="VAR" id="var_stake">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="multiply_stake">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <shadow type="math_number" id="mult_a_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="get_stake_mult">
                    <field name="VAR" id="var_stake">stake</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="mult_b_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="get_mart_mult">
                    <field name="VAR" id="var_martingale">martingale</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_recovery_true">
                <field name="VAR" id="var_recovery_mode">recovery_mode</field>
                <value name="VALUE">
                  <block type="logic_boolean" id="bool_true_loss">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="check_tp_sl">
            <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="compare_tp">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="total_profit" id="get_total_profit_tp"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_take_profit">
                    <field name="VAR" id="var_take_profit">take_profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="print_tp">
                <value name="TEXT">
                  <shadow type="text" id="text_tp_hit">
                    <field name="TEXT">Take Profit Hit - Bot Stopped</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="compare_sl">
                <field name="OP">LTE</field>
                <value name="A">
                  <block type="total_profit" id="get_total_profit_sl"></block>
                </value>
                <value name="B">
                  <block type="math_single" id="negate_sl">
                    <field name="OP">NEG</field>
                    <value name="NUM">
                      <shadow type="math_number" id="sl_shadow">
                        <field name="NUM">9</field>
                      </shadow>
                      <block type="variables_get" id="get_stop_loss">
                        <field name="VAR" id="var_stop_loss">stop_loss</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="text_print" id="print_sl">
                <value name="TEXT">
                  <shadow type="text" id="text_sl_hit">
                    <field name="TEXT">Stop Loss Hit - Bot Stopped</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again" id="trade_again_block"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase_block" deletable="false" x="0" y="1206">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="if_next_trade_purchase">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="compare_under_purchase">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_next_trade_purchase">
                <field name="VAR" id="var_next_trade">next_trade</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="text_under_purchase">
                <field name="TEXT">UNDER</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="purchase_over">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="purchase_under">
            <field name="PURCHASE_LIST">DIGITUNDER</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>